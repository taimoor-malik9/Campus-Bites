<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectedPhotoAccess">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="PhotoAndVideoPolicy,SelectedPhotoAccess" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_campus_bites_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_campus_bites_logo"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".MyApplication"
        android:theme="@style/Theme.CampusBites">

        <!-- ========== SPLASH (LAUNCHER) ========== -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase-2 AI Assistant -->
        <activity
            android:name=".AiAssistantActivity"
            android:exported="false" />

        <!-- AI Food Agent (legacy/simple) -->
        <activity
            android:name=".AiChatActivity"
            android:exported="false" />

        <!-- ========== ROLE SELECTION (NEW) ========== -->
        <activity
            android:name=".RoleSelectionActivity"
            android:exported="false" />

        <!-- ========== SELLER SIDE (EXISTING) ========== -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterStoreActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".AddEditItemActivity"
            android:exported="false" />

        <!-- ========== CUSTOMER SIDE (NEW) ========== -->
        <activity
            android:name=".CustomerLoginActivity"
            android:exported="false" />
        <activity
            android:name=".CustomerRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".CustomerMainActivity"
            android:exported="false" />
        <activity
            android:name=".StoreDetailActivity"
            android:exported="false" />
        <activity
            android:name=".FoodDetailActivity"
            android:exported="false" />
        <activity
            android:name=".CheckoutActivity"
            android:exported="false" />

    </application>

</manifest>